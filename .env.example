# Environment Variables Template

# Database Connection (Required)
# Get this from: https://console.neon.tech → Connection String
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# JWT Secret (Required)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This should be a random 32-character string
JWT_SECRET=your_random_secret_key_here

# Merriam-Webster API Key (Optional)
# Get from: https://www.dictionaryapi.com
# Leave blank to use default behavior
MERRIAM_WEBSTER_API_KEY=

# Port for local development (Optional)
# Default is 3001, change if needed
PORT=3001
